# Kopieren nach .env und Werte anpassen (.env wird nicht committet)

# Version des fertigen Images (ghcr.io/reschcloud/ladefalke), siehe CHANGELOG.md; für ein Update hier ändern und
# „docker compose pull && docker compose up -d“. Ohne Angabe: neueste Version („latest“).
LADEFALKE_VERSION=1.6.0

POSTGRES_DB=ladekosten
POSTGRES_USER=ladekosten
POSTGRES_PASSWORD=bitte-aendern

# Anmeldung (ein Admin-Benutzer)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern

# Zufälliger Schlüssel für Session-Cookies, z. B.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern

# Sicherungen verschlüsseln (empfohlen, enthalten Personendaten). Passwort sicher aufbewahren – ohne ist die
# Sicherung wertlos. Leer = unverschlüsselt (Warnung unter Einstellungen → Backup).
BACKUP_PASSWORT=

TZ=Europe/Vienna
APP_PORT=8000

# HTTPS (siehe README „HTTPS und Reverse Proxy“)
# an:  HTTPS direkt in der App – selbstsigniertes Zertifikat in data/tls (oder eigenes cert.pem/key.pem dort)
# aus: HTTP für den Betrieb hinter einem Reverse Proxy, der HTTPS übernimmt
TLS=an
# Weitere Namen/IP-Adressen für das selbstsignierte Zertifikat (Leerzeichen getrennt), z. B. Servername im LAN
TLS_NAMEN=
# Nur bei TLS=aus: Adressen des Reverse Proxys, deren X-Forwarded-*-Header gelten (Standard: alle)
FORWARDED_ALLOW_IPS=*
# Sitzungs-Cookie nur über HTTPS (Standard true); nur für reinen HTTP-Testbetrieb ohne Proxy auf false
COOKIE_SECURE=true

# Sicherung vor Datenbank-Migrationen beim Start (Standard an; schlägt sie fehl, startet die App nicht)
#BACKUP_VOR_UPDATE=aus

# Nur Entwicklung: Image mit Testwerkzeugen und Beispieldateien (compose.dev.yaml). Auf Servern weglassen.
#COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Quelltext dieser Installation, verlinkt im Footer (AGPL-3.0). Nur ändern, wenn du eine veränderte Version betreibst.
#QUELLTEXT_URL=https://github.com/reschcloud/ladefalke
